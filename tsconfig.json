{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src",
    "modules",
    "lib",
    "components",
    "hooks",
    "types",
    "scripts",
    "*.ts",
    "*.tsx",
    "*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "pasta sem título",
    "pasta sem título",
    "supabase",
    "dist",
    "tmp"
  ]
}
