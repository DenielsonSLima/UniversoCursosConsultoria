VITE_APP_MODE=development
VITE_PUBLIC_SITE_URL=https://example.com

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Supabase Edge Function secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
PORTAL_ALLOWED_REDIRECT_ORIGINS=https://example.com,http://localhost:3000
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_NATIVE_SITE_KEY=
# Página HTTPS mínima que hospeda o challenge usado pelos apps Capacitor.
VITE_NATIVE_TURNSTILE_URL=https://example.com/native-auth/turnstile
VITE_TURNSTILE_LOCAL_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_SECRET_KEY=
# Opcional quando o challenge nativo usa o mesmo widget de produção: nesse
# caso o backend reutiliza TURNSTILE_SECRET_KEY sem duplicar o segredo.
TURNSTILE_NATIVE_SECRET_KEY=
TURNSTILE_NATIVE_ALLOWED_HOSTNAMES=example.com
# Use uma chave real de widget local/homologação. Chaves universais de teste
# da Cloudflare são recusadas pelo endpoint público para evitar bypass.
TURNSTILE_LOCAL_SECRET_KEY=
TURNSTILE_LOCAL_HOSTNAMES=localhost,127.0.0.1
TURNSTILE_ALLOWED_HOSTNAMES=universocc.com.br,www.universocc.com.br
